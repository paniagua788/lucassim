---
interface Props {
  showBack?: boolean;
  showHomeLink?: boolean;
  showLangToggle?: boolean;
  /** Tema claro (página de Slotr). */
  light?: boolean;
}

const { showBack = false, showHomeLink = false, showLangToggle = false, light = false } = Astro.props;

const navCls  = light ? 'border-md-outline-variant bg-md-background/90' : 'border-border bg-base/90';
const homeCls = light ? 'hover:text-md-primary' : 'hover:text-muted';
const linkCls = light ? 'text-md-on-surface-variant hover:text-md-primary' : 'text-muted hover:text-white';
const pillCls = light ? 'bg-md-surface-container' : 'bg-surface';
// El botón activo se marca con aria-pressed; el script de la página solo cambia ese atributo.
const langBtn = light
  ? 'text-md-on-surface-variant aria-pressed:bg-md-primary aria-pressed:text-white'
  : 'text-muted aria-pressed:bg-white aria-pressed:text-gray-900';
---

<nav class={`fixed top-0 left-0 right-0 z-50 border-b backdrop-blur-sm ${navCls}`}>
  <div class="max-w-5xl lg:max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class={`text-sm font-bold tracking-widest uppercase transition-colors ${homeCls}`}>
      lucassim
    </a>

    <div class="flex items-center gap-4">
      {showBack ? (
        <a href="/" class={`text-xs font-semibold transition-colors flex items-center gap-1.5 ${linkCls}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Volver
        </a>
      ) : (
        <div class="flex gap-8">
          <a href="/#productos" class={`text-sm transition-colors ${linkCls}`}>
            Proyectos
          </a>
          <a href="/#contacto" class={`text-sm transition-colors ${linkCls}`}>
            Contacto
          </a>
        </div>
      )}

      {showHomeLink && (
        <a href="/" class={`text-xs font-semibold transition-colors ${linkCls}`}>
          Inicio
        </a>
      )}

      {showLangToggle && (
        <div class={`flex gap-1 p-1 rounded-lg ${pillCls}`}>
          <button data-lang-btn data-target="es" aria-pressed="true"
            class={`px-3 py-1 text-xs font-semibold rounded-md transition-colors ${langBtn}`}>
            ES
          </button>
          <button data-lang-btn data-target="en" aria-pressed="false"
            class={`px-3 py-1 text-xs font-semibold rounded-md transition-colors ${langBtn}`}>
            EN
          </button>
        </div>
      )}
    </div>
  </div>
</nav>

<div class="h-14"></div>

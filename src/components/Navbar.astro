---
interface Props {
  showBack?: boolean;
  showHomeLink?: boolean;
  showLangToggle?: boolean;
  /** Tema claro de la página de producto. */
  theme?: 'dark' | 'slotr' | 'vareapp';
}

const { showBack = false, showHomeLink = false, showLangToggle = false, theme = 'dark' } = Astro.props;

// El botón activo se marca con aria-pressed; el script de la página solo cambia ese atributo.
const themes = {
  dark: {
    nav: 'border-border bg-base/90', home: 'hover:text-muted', link: 'text-muted hover:text-white', pill: 'bg-surface',
    lang: 'text-muted aria-pressed:bg-white aria-pressed:text-gray-900',
  },
  slotr: {
    nav: 'border-md-outline-variant bg-md-background/90', home: 'hover:text-md-primary',
    link: 'text-md-on-surface-variant hover:text-md-primary', pill: 'bg-md-surface-container',
    lang: 'text-md-on-surface-variant aria-pressed:bg-md-primary aria-pressed:text-white',
  },
  vareapp: {
    nav: 'border-stone-200 bg-white/90 text-stone-900', home: 'hover:text-orange-700',
    link: 'text-stone-600 hover:text-orange-700', pill: 'bg-stone-100',
    lang: 'text-stone-600 aria-pressed:bg-orange-500 aria-pressed:text-stone-900',
  },
};
const { nav: navCls, home: homeCls, link: linkCls, pill: pillCls, lang: langBtn } = themes[theme];
---

<nav class={`fixed top-0 left-0 right-0 z-50 border-b backdrop-blur-sm ${navCls}`}>
  <div class="max-w-5xl lg:max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class={`text-sm font-bold tracking-widest uppercase transition-colors ${homeCls}`}>
      lucassim
    </a>

    <div class="flex items-center gap-4">
      {showBack ? (
        <a href="/" class={`text-xs font-semibold transition-colors flex items-center gap-1.5 ${linkCls}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Volver
        </a>
      ) : (
        <div class={`${showLangToggle ? 'hidden sm:flex' : 'flex'} gap-8`}>
          <a href="/#productos" class={`text-sm transition-colors ${linkCls}`}>
            Proyectos
          </a>
          <a href="/#contacto" class={`text-sm transition-colors ${linkCls}`}>
            Contacto
          </a>
        </div>
      )}

      {showHomeLink && (
        <a href="/" class={`text-xs font-semibold transition-colors ${linkCls}`}>
          Inicio
        </a>
      )}

      {showLangToggle && (
        <div class={`flex gap-1 p-1 rounded-lg ${pillCls}`}>
          <button data-lang-btn data-target="es" aria-pressed="true"
            class={`px-3 py-1 text-xs font-semibold rounded-md transition-colors ${langBtn}`}>
            ES
          </button>
          <button data-lang-btn data-target="en" aria-pressed="false"
            class={`px-3 py-1 text-xs font-semibold rounded-md transition-colors ${langBtn}`}>
            EN
          </button>
        </div>
      )}
    </div>
  </div>
</nav>

<div class="h-14"></div>

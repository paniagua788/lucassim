---
import { icons, type IconName } from './icons';

interface Feature {
  icon: IconName;
  name: string;
  description: string;
}

interface Props {
  heading: string;
  description: string;
  features: Feature[];
  icon: IconName;
  isNew?: boolean;
  isNewLabel?: string;
  span?: number;
}

const { heading, description, features, icon, isNew, isNewLabel = 'Nuevo', span = 1 } = Astro.props;

// Map span values to responsive col-span classes (only applied at lg breakpoint)
const spanClasses: Record<number, string> = {
  1: 'lg:col-span-1',
  2: 'lg:col-span-2',
  3: 'lg:col-span-3',
  4: 'lg:col-span-4',
  5: 'lg:col-span-5',
  6: 'lg:col-span-6',
  7: 'lg:col-span-7',
  8: 'lg:col-span-8',
  9: 'lg:col-span-9',
  10: 'lg:col-span-10',
  11: 'lg:col-span-11',
  12: 'lg:col-span-12',
};

const spanClass = spanClasses[span] || 'lg:col-span-1';

// Sub-grid columns: responsive based on card span and feature count
// For span-6 cards (half width): max 2 cols on desktop to avoid narrow items
// For span-12 cards (full width): can use 3 cols for 5+ features
const isHalfWidth = span <= 6;

const subGridCols = features.length >= 5
  ? isHalfWidth
    ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-2'
    : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
  : features.length >= 3
    ? 'grid-cols-1 md:grid-cols-2'
    : 'grid-cols-1';
---

<div class={`slotr-card rounded-2xl p-8 ${isNew
  ? 'bg-gradient-to-br from-violet-500/10 to-purple-500/5 border border-violet-500/25'
  : 'bg-white/[0.03] border border-white/[0.06]'
} ${spanClass}`}>
  <div class="mb-6">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span class="text-slotr category-icon-lg" set:html={icons[icon]}></span>
      {heading}
      {isNew && (
        <span class="bg-violet-500/20 text-violet-300 text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded">{isNewLabel}</span>
      )}
    </h3>
    <p class="text-sm text-subtle mt-2">{description}</p>
  </div>

  <!-- Sub-grid: responsive columns -->
  <div class={`grid gap-4 ${subGridCols}`}>
    {features.map(f => (
      <div class={`p-5 rounded-xl ${isNew ? 'bg-white/[0.03] border border-violet-500/12' : 'bg-white/[0.02] border border-white/[0.04]'}`}>
        <span class="text-slotr category-icon-sm mb-2" set:html={icons[f.icon]}></span>
        <p class="text-base font-bold text-white mb-1.5">{f.name}</p>
        <p class="text-sm text-subtle leading-relaxed">{f.description}</p>
      </div>
    ))}
  </div>
</div>

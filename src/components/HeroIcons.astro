---
// Íconos flotantes decorativos para la banda de color del hero (VareApp, Slotr).
// Ubicados en los márgenes y entre columnas para no tapar el texto ni la vista de la app.
// En celular solo se muestra el primero (esquina derecha, junto al logo): el resto tapaba el título.
// La animación se apaga con prefers-reduced-motion (global.css).
interface Props {
  icons: string[]; // SVG en orden de prioridad, hasta 6
}
const { icons } = Astro.props;

const slots = [
  'top-[6%] right-[6%] w-9 h-9 hero-icon-float',
  'hidden lg:block top-[78%] right-[44%] w-7 h-7 hero-icon-float-reverse',
  'hidden lg:block top-[10%] left-[47%] w-10 h-10 hero-icon-float-reverse',
  'hidden lg:block bottom-[8%] left-[3%] w-8 h-8 hero-icon-float',
  'hidden lg:block top-[8%] left-[2%] w-7 h-7 hero-icon-float-reverse',
  'hidden lg:block bottom-[10%] right-[2%] w-9 h-9 hero-icon-float',
];
---

<div class="absolute inset-0 pointer-events-none" aria-hidden="true">
  {icons.slice(0, slots.length).map((svg, i) => (
    <span class={`absolute text-white/30 [&>svg]:w-full [&>svg]:h-full ${slots[i]}`} style={`animation-delay:-${i * 3}s`} set:html={svg}></span>
  ))}
</div>

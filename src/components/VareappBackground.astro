---
// src/components/VareappBackground.astro
// Page-level background decorations for the vareapp landing page.
// Includes radial gradient shapes, subtle grid pattern, and floating food icons
// distributed across the full page height (not just the hero).
import { vareappIcons } from './vareapp-icons';
---

<div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <!-- Radial gradient shapes — distributed across the page -->
  <div class="hero-shape absolute top-[5%] left-[10%] w-[180px] h-[180px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.20), transparent 70%); filter: blur(40px);"></div>
  <div class="hero-shape-reverse absolute top-[22%] right-[8%] w-[220px] h-[220px] rounded-full" style="background: radial-gradient(circle, rgba(234,88,12,0.18), transparent 70%); filter: blur(50px);"></div>
  <div class="hero-shape absolute top-[40%] left-[5%] w-[160px] h-[160px] rounded-full" style="background: radial-gradient(circle, rgba(251,146,60,0.12), transparent 70%); filter: blur(35px);"></div>
  <div class="hero-shape-reverse absolute top-[58%] right-[12%] w-[200px] h-[200px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.15), transparent 70%); filter: blur(30px);"></div>
  <div class="hero-shape absolute top-[78%] left-[20%] w-[140px] h-[140px] rounded-full" style="background: radial-gradient(circle, rgba(251,146,60,0.12), transparent 70%); filter: blur(40px);"></div>

  <!-- Subtle grid pattern — covers full page with edge fade -->
  <div class="absolute inset-0" style="background-image: linear-gradient(rgba(249,115,22,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(249,115,22,0.03) 1px, transparent 1px); background-size: 60px 60px; mask-image: linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);"></div>

  <!-- Floating food icons — distributed across the full page -->

  <!-- Hero area (0–20%) -->
  <div class="hero-icon-float absolute top-[3%] right-[15%]" style="opacity: 0.12;" aria-hidden="true">
    <span set:html={vareappIcons.chefHat} style="width:32px;height:32px;display:block;color:#fb923c;"></span>
  </div>
  <div class="hero-icon-float-reverse absolute top-[10%] left-[6%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.shoppingBag} style="width:26px;height:26px;display:block;color:#ea580c;"></span>
  </div>
  <div class="hero-icon-float absolute top-[15%] right-[30%]" style="opacity: 0.08;" aria-hidden="true">
    <span set:html={vareappIcons.receipt} style="width:22px;height:22px;display:block;color:#f97316;"></span>
  </div>

  <!-- Features area (25–45%) -->
  <div class="hero-icon-float-reverse absolute top-[28%] left-[4%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.coffee} style="width:28px;height:28px;display:block;color:#fb923c;"></span>
  </div>
  <div class="hero-icon-float absolute top-[35%] right-[18%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.flame} style="width:26px;height:26px;display:block;color:#f97316;"></span>
  </div>
  <div class="hero-icon-float-reverse absolute top-[42%] left-[10%]" style="opacity: 0.08;" aria-hidden="true">
    <span set:html={vareappIcons.utensilsCrossed} style="width:24px;height:24px;display:block;color:#ea580c;"></span>
  </div>

  <!-- Business types area (50–65%) -->
  <div class="hero-icon-float absolute top-[52%] right-[8%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.barcode} style="width:24px;height:24px;display:block;color:#fb923c;"></span>
  </div>
  <div class="hero-icon-float-reverse absolute top-[60%] left-[6%]" style="opacity: 0.08;" aria-hidden="true">
    <span set:html={vareappIcons.package2} style="width:22px;height:22px;display:block;color:#f97316;"></span>
  </div>

  <!-- Pricing area (68–85%) -->
  <div class="hero-icon-float absolute top-[70%] right-[22%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.tag} style="width:24px;height:24px;display:block;color:#ea580c;"></span>
  </div>
  <div class="hero-icon-float-reverse absolute top-[78%] left-[12%]" style="opacity: 0.08;" aria-hidden="true">
    <span set:html={vareappIcons.star} style="width:22px;height:22px;display:block;color:#fb923c;"></span>
  </div>

  <!-- Contact area (88–100%) -->
  <div class="hero-icon-float absolute top-[88%] right-[10%]" style="opacity: 0.10;" aria-hidden="true">
    <span set:html={vareappIcons.store} style="width:22px;height:22px;display:block;color:#f97316;"></span>
  </div>
  <div class="hero-icon-float-reverse absolute top-[95%] left-[8%]" style="opacity: 0.08;" aria-hidden="true">
    <span set:html={vareappIcons.pizza} style="width:20px;height:20px;display:block;color:#fb923c;"></span>
  </div>
</div>

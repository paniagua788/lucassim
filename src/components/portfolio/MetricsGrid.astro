---
// src/components/portfolio/MetricsGrid.astro
// Sección de métricas clave. Bilingüe con data-lang.
// Solo cifras con respaldo en repos/informes (git, Terraform, informes IGR de DigTem).
const metrics: [string, string, string][] = [
  ['7+ años', 'En tecnología: redes, soporte, infraestructura y desarrollo', 'In tech: networking, support, infrastructure and development'],
  ['1.900+', 'Commits en AVALX y DigTem desde 2025', 'Commits to AVALX and DigTem since 2025'],
  ['7', 'Servicios en AWS ECS Fargate operados en AVALX', 'AWS ECS Fargate services run at AVALX'],
  ['2', 'Productos SaaS propios: VareApp y Slotr', 'Own SaaS products: VareApp and Slotr'],
  ['< 6 s', 'Arranque de DigTem, antes ~9,5 s', 'DigTem startup, down from ~9.5 s'],
  ['2 h → 11 s', 'Build del instalador de DigTem', 'DigTem installer build time'],
  ['500+', 'Usuarios soportados en Itaipú Binacional', 'Users supported at Itaipú Binacional'],
  ['18', 'Certificaciones', 'Certifications'],
];
const enValue = (v: string) => v.replace('años', 'years').replace('1.900+', '1,900+');
---

<!-- ESPAÑOL -->
<section data-lang="es" class="py-12 container-page">
  <h2 class="text-xs text-muted uppercase tracking-widest mb-6">Métricas Clave</h2>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 lg:gap-4">
    {metrics.map(([value, es]) => (
      <div class="bg-surface border border-border rounded-xl p-4 lg:p-6 text-center">
        <p class="text-2xl lg:text-4xl font-black text-white mb-1">{value}</p>
        <p class="text-xs text-muted leading-snug">{es}</p>
      </div>
    ))}
  </div>
</section>

<!-- ENGLISH -->
<section data-lang="en" class="hidden py-12 container-page">
  <h2 class="text-xs text-muted uppercase tracking-widest mb-6">Key Metrics</h2>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 lg:gap-4">
    {metrics.map(([value, , en]) => (
      <div class="bg-surface border border-border rounded-xl p-4 lg:p-6 text-center">
        <p class="text-2xl lg:text-4xl font-black text-white mb-1">{enValue(value)}</p>
        <p class="text-xs text-muted leading-snug">{en}</p>
      </div>
    ))}
  </div>
</section>

---
// src/components/portfolio/MetricsGrid.astro
// Sección de métricas clave. Bilingüe con data-lang.
---

<!-- ESPAÑOL -->
<section data-lang="es" class="py-12 px-6 max-w-4xl mx-auto">
  <h2 class="text-xs text-muted uppercase tracking-widest mb-6">Métricas Clave</h2>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">40%</p>
      <p class="text-xs text-muted leading-snug">Reducción en tiempos de resolución de incidentes</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">60%</p>
      <p class="text-xs text-muted leading-snug">Reducción en tiempos de espera de clientes (Slotr)</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">99.5%</p>
      <p class="text-xs text-muted leading-snug">Uptime sostenido en infraestructura crítica</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">95%+</p>
      <p class="text-xs text-muted leading-snug">Satisfacción de usuarios en soporte técnico</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">99%+</p>
      <p class="text-xs text-muted leading-snug">Tickets resueltos sin escalación a Tier 2/3</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">500+</p>
      <p class="text-xs text-muted leading-snug">Usuarios empresariales soportados</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">10+ hs</p>
      <p class="text-xs text-muted leading-snug">Ahorradas por semana mediante automatización con scripts</p>
    </div>

    <div class="bg-surface border border-border rounded-xl p-4 text-center">
      <p class="text-2xl font-black text-white mb-1">3+ años</p>
      <p class="text-xs text-muted leading-snug">Experiencia avanzada con ServiceNow</p>
    </div>

  </div>
</section>

<!-- ENGLISH -->

---
// src/components/portfolio/SkillsGrid.astro
// Grilla de habilidades técnicas por categoría. Bilingüe con data-lang.
---

<!-- ESPAÑOL -->
<section data-lang="es" class="py-12 container-page">
  <h2 class="text-xs text-muted uppercase tracking-widest mb-6">Habilidades Técnicas</h2>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Backend</p>
      <div class="flex flex-wrap gap-1.5">
        {['Python', 'Flask', 'FastAPI', 'Django REST', 'Node.js / Express', 'REST APIs', 'Webhooks', 'C', 'SOLID', 'Pytest'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Frontend &amp; Desktop</p>
      <div class="flex flex-wrap gap-1.5">
        {['JavaScript', 'TypeScript', 'React', 'Astro', 'TailwindCSS', 'Jinja2', 'PySide6 / Qt'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Bases de datos</p>
      <div class="flex flex-wrap gap-1.5">
        {['PostgreSQL', 'MongoDB', 'MySQL', 'Redis', 'SQLAlchemy', 'PyMongo', 'Alembic', 'SQLite'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">DevOps / Cloud</p>
      <div class="flex flex-wrap gap-1.5">
        {['AWS (ECS Fargate, RDS, ECR, ALB, CodeBuild, S3, Lambda)', 'Terraform', 'Docker', 'Dokploy', 'Cloudflare', 'CI/CD', 'Git & GitHub', 'Linux avanzado', 'Bash scripting'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Dominios</p>
      <div class="flex flex-wrap gap-1.5">
        {['Pagos USDT / TRON', 'Contabilidad de partida doble', 'Factura electrónica SIFEN', 'IEC 61850', 'GOOSE / MMS / Sampled Values', 'SCL (CID/ICD/SCD)', 'libiec61850', 'WhatsApp Cloud API', 'Telegram Bot API'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Infraestructura</p>
      <div class="flex flex-wrap gap-1.5">
        {['Active Directory', 'GPOs', 'Windows Server', 'PowerShell', 'Hyper-V', 'VMware', 'MECM', 'Sysprep/PXE', 'Redes TCP/IP', 'VLANs', 'DNS', 'DHCP', 'Firewalls', 'Storage empresarial', 'Backup y recuperación'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">ITSM & Gestión</p>
      <div class="flex flex-wrap gap-1.5">
        {['ServiceNow (3+ años, avanzado)', 'ITIL 4 Foundation', 'Jira', 'Confluence', 'SLAs/KPIs', 'Gestión de activos TI', 'Gestión de compras y proveedores', 'Gestión de licencias'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Metodologías</p>
      <div class="flex flex-wrap gap-1.5">
        {['Scrum (Certificado)', 'Kanban', 'Documentación técnica', 'ADRs', 'OpenAPI/Swagger'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5">
      <p class="text-sm font-semibold text-white mb-3">Idiomas</p>
      <div class="flex flex-wrap gap-1.5">
        {['Español (nativo)', 'Inglés C1 Advanced', 'Portugués (avanzado)'].map(t => (
          <span class="px-2 py-0.5 bg-base border border-border text-muted rounded text-xs">{t}</span>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- ENGLISH -->

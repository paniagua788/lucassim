---
// src/components/portfolio/PortfolioNavbar.astro
// Navbar light con toggle de idioma para la página portfolio.
// Sin props — los botones del toggle son manejados por el script en portfolio.astro.
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-base/90 backdrop-blur-sm">
  <div class="container-page h-14 flex items-center justify-between">
    <a href="/" class="text-sm font-bold tracking-widest uppercase text-white hover:text-muted transition-colors">
      lucassim
    </a>

    <div class="flex items-center gap-4">
      <!-- Lang toggle -->
      <div class="flex gap-1 p-1 bg-surface rounded-lg">
        <button
          data-lang-btn
          data-target="es"
          class="px-3 py-1 text-xs font-semibold rounded-md bg-white text-gray-900 transition-colors"
        >
          ES
        </button>
        <button
          data-lang-btn
          data-target="en"
          class="px-3 py-1 text-xs font-semibold rounded-md text-muted transition-colors"
        >
          EN
        </button>
      </div>

    </div>
  </div>
</nav>

<!-- Spacer para compensar la navbar fixed -->
<div class="h-14"></div>

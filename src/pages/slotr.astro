---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { icons, type IconName } from '../components/icons';
import HeroIcons from '../components/HeroIcons.astro';

// Página con el tema claro de la app Slotr: tokens md-* (paleta morada MD3), Roboto y JetBrains Mono.
const WHATSAPP = 'https://wa.me/595993294266';
const EMAIL    = 'lucas_paniagua@hotmail.com';

interface Feature { icon: IconName; name: string; description: string }
interface Category { heading: string; description: string; icon: IconName; isNew?: boolean; wide?: boolean; features: Feature[] }

const copy = {
  es: {
    title: 'Turnos online, sin complicaciones',
    lead: 'Reservas, agenda, caja y factura electrónica para clínicas, peluquerías, consultoras y canchas deportivas en Paraguay.',
    cta: 'Consultá por una demo',
    mock: {
      label: 'Vista de la página de reservas de Slotr: el cliente elige servicio, fecha y horario.',
      service: 'Corte y barba', meta: '45 min · 80.000 Gs.', date: 'Jueves 4 de diciembre',
      slots: 'Horarios disponibles', confirm: 'Confirmar turno',
    },
    featuresTitle: '¿Qué incluye Slotr?',
    featuresLead: 'Todo lo que necesitás para que tus clientes reserven solos.',
    newLabel: 'Nuevo',
    categories: [
      { heading: 'Caja y facturación', description: 'Lo que entra y sale del negocio, en un solo lugar.', icon: 'wallet', isNew: true, wide: true, features: [
        { icon: 'wallet', name: 'Libro de caja', description: 'Los turnos atendidos se suman solos como ingreso. Ves ingresos, egresos y saldo de cualquier período, día por día.' },
        { icon: 'shoppingBag', name: 'Ventas sin turno', description: 'Registrá ventas que no vienen de una reserva, como un producto o un servicio en el momento, con o sin factura.' },
        { icon: 'trendingDown', name: 'Egresos', description: 'Cargá gastos como alquiler, insumos o sueldos y el saldo del período los descuenta.' },
        { icon: 'userX', name: 'Turnos no asistidos', description: 'Si un cliente no vino, cancelás el turno pasado y deja de contar en la caja. Si era un mantenimiento, la cadena termina.' },
        { icon: 'receipt', name: 'Factura electrónica SIFEN', description: 'Facturá turnos y ventas desde la caja, con numeración automática, anulación y reemisión. Requiere el timbrado y el certificado del negocio.' },
        { icon: 'printer', name: 'Ticket de 80 mm', description: 'Al facturar se abre el KuDE listo para imprimir en una impresora térmica de 80 mm.' },
        { icon: 'list', name: 'Factura pedida al reservar', description: 'El cliente puede pedir factura e indicar RUC y razón social al reservar. Esos datos aparecen cargados al facturar.' },
      ] },
      { heading: 'Reservas', description: 'Todo para que tus clientes reserven fácil.', icon: 'calendar', features: [
        { icon: 'calendar', name: 'Reservas online', description: 'Página pública donde tus clientes reservan su turno sin llamar.' },
        { icon: 'list', name: 'Múltiples servicios', description: 'Servicios con duración y rango de precios. Con 10 o más servicios, los clientes navegan por categoría primero.' },
        { icon: 'link', name: 'Multi-servicios', description: 'Tus clientes pueden reservar varios servicios en una sola cita. El sistema calcula duración total y precio combinado automáticamente.' },
        { icon: 'folder', name: 'Categorías y precios', description: 'Organizá tus servicios por categoría y mostrá rangos de precio para que el cliente tenga una idea clara antes de reservar.' },
        { icon: 'repeat', name: 'Mantenimientos', description: 'Para servicios que necesitan retoque, como extensiones, el cliente recibe un enlace para reservar el mantenimiento dentro del plazo que definas.' },
        { icon: 'calendarPlus', name: 'Añadir al calendario', description: 'Desde la confirmación, el cliente agrega el turno a Google Calendar o a cualquier calendario con un archivo .ics.' },
      ] },
      { heading: 'Gestión', description: 'Control total de tu equipo y tu agenda.', icon: 'grid', features: [
        { icon: 'grid', name: 'Gestión de agenda', description: 'Vista de calendario por recurso con bloqueos y cancelaciones.' },
        { icon: 'users', name: 'Staff y recursos', description: 'Soporte para personas y recursos físicos, con roles admin/staff y permisos granulares por módulo.' },
        { icon: 'settings', name: 'Panel administrativo', description: 'Configuración completa: horarios, servicios, bloqueos y ajustes del negocio.' },
        { icon: 'lock', name: 'Bloqueos con motivo', description: 'Bloqueá horarios, días completos o rangos de fechas indicando el motivo. Visible en la agenda para todo el equipo.' },
        { icon: 'shield', name: 'Permisos granulares', description: 'Controlá quién ve y gestiona cada agenda. Permisos independientes por staff para agenda, bloqueos y configuración.' },
      ] },
      { heading: 'Sucursales', description: 'Varios locales, un solo panel.', icon: 'building', features: [
        { icon: 'building', name: 'Multi-sucursal', description: 'Configurá todas tus ubicaciones físicas. Cada sucursal con su nombre, horarios y staff propio.' },
        { icon: 'clock', name: 'Horarios por sucursal', description: 'Cada sucursal tiene su propio horario de atención, independiente de las demás.' },
        { icon: 'users', name: 'Staff asignado', description: 'Asigná cada profesional a una sucursal específica. El sistema filtra quién atiende dónde.' },
        { icon: 'mapPin', name: 'Selector público', description: 'Cuando tenés más de una sucursal activa, tus clientes eligen dónde reservar en el primer paso.' },
      ] },
      { heading: 'Comunicación', description: 'Mantené informados a tus clientes y a tu equipo.', icon: 'bell', features: [
        { icon: 'bell', name: 'Avisos por Telegram', description: 'Cada profesional recibe en Telegram las reservas de su agenda. Las reservas de espacios llegan a los administradores.' },
        { icon: 'mail', name: 'Confirmación por email', description: 'Tus clientes reciben un email con los detalles de su turno al confirmar la reserva.' },
        { icon: 'clock', name: 'Recordatorios automáticos', description: 'Recordatorios enviados automáticamente antes del turno para reducir ausencias.' },
        { icon: 'messageCircle', name: 'WhatsApp Business', description: 'Con tu cuenta de WhatsApp Business, el cliente recibe la confirmación y el recordatorio por WhatsApp aunque no deje email, y el enlace de mantenimiento junto con el correo. Requiere plantillas aprobadas por Meta.' },
        { icon: 'messageCircle', name: 'Botón de WhatsApp', description: 'En la pantalla de confirmación, el cliente te envía los datos de su turno por WhatsApp con un toque.' },
      ] },
      { heading: 'Marketing', description: 'Atraé más clientes y fidelizá a los que ya tenés.', icon: 'sparkles', features: [
        { icon: 'sparkles', name: 'Eventos y Promociones', description: 'Creá promociones con descuentos porcentuales o fijos, notificaciones visuales con íconos y banners de color. Solo un evento activo a la vez. Tus clientes ven las ofertas directamente en la página de reservas.' },
        { icon: 'star', name: 'Reseñas de clientes', description: 'Los clientes califican su experiencia con estrellas y texto. El puntaje promedio y las reseñas recientes se muestran en tu página pública.' },
        { icon: 'eyeOff', name: 'Moderación de reseñas', description: 'Ocultá desde el panel las reseñas que no correspondan. Las ocultas no se muestran ni cuentan en el promedio, y podés volver a mostrarlas.' },
      ] },
      { heading: 'Analytics', description: 'Datos claros para tomar mejores decisiones.', icon: 'activity', features: [
        { icon: 'activity', name: 'Dashboard de métricas', description: 'KPIs de turnos e ingresos estimados, gráficos por período (7, 30, 90 o 365 días, o el mes actual), ranking de servicios, franjas horarias pico y clientes frecuentes.' },
        { icon: 'palette', name: 'Personalización', description: '21 temas de color, claros y oscuros, logo propio y etiquetas configurables. Tu sistema de turnos con tu identidad visual.' },
      ] },
    ] as Category[],
    targetTitle: 'Para cualquier negocio que trabaje con turnos',
    targetLead: 'Si tu negocio agenda citas, Slotr es para vos.',
    target: ['Clínicas', 'Peluquerías', 'Consultoras', 'Canchas deportivas', 'Consultorios'],
    targetAny: 'Cualquier negocio que agenda citas',
    pricingTitle: 'Precio según tu equipo',
    pricingLead: 'Pagás por los calendarios que usás. Sin costos fijos por funciones que no necesitás.',
    pricingNote: 'Precio base incluye 1 recurso/calendario. Cada recurso adicional tiene un costo adicional.',
    pricing: [
      { count: '1', unit: 'recurso', example: 'Consultorio individual, peluquero solo', featured: false },
      { count: '2–3', unit: 'recursos', example: '3 canchas de pádel, 2 profesionales', featured: true },
      { count: '4+', unit: 'recursos', example: 'Clínica con múltiples especialistas', featured: false },
    ],
    pricingCta: 'Consultá',
    supportTitle: 'Soporte directo y pedidos de mejora, siempre incluidos',
    supportText: '¿Necesitás una función nueva o que algo funcione distinto? Pedilo. Según la dificultad, lo aplico enseguida o lo sumo a lo próximo. Lo que le resuelve un problema a un negocio casi siempre le sirve a todos, por eso cada pedido cuenta.',
    closingTitle: '¿Querés que tus clientes reserven solos?',
    closingLead: 'Escribime y te muestro cómo funciona.',
  },
  en: {
    title: 'Online appointments, hassle-free',
    lead: 'Bookings, schedule, cash book and e-invoicing for clinics, hair salons, consultancies and sports courts in Paraguay.',
    cta: 'Request a demo',
    mock: {
      label: "Slotr's booking page: the client picks a service, a date and a time.",
      service: 'Haircut & beard', meta: '45 min · 80.000 Gs.', date: 'Thursday, December 4',
      slots: 'Available times', confirm: 'Confirm booking',
    },
    featuresTitle: "What's included in Slotr?",
    featuresLead: 'Everything you need for your clients to book on their own.',
    newLabel: 'New',
    categories: [
      { heading: 'Cash book & invoicing', description: 'Money in and money out, in one place.', icon: 'wallet', isNew: true, wide: true, features: [
        { icon: 'wallet', name: 'Cash book', description: 'Completed appointments are added as income automatically. See income, expenses and balance for any period, day by day.' },
        { icon: 'shoppingBag', name: 'Walk-in sales', description: "Record sales that don't come from a booking, like a product or an on-the-spot service, with or without an invoice." },
        { icon: 'trendingDown', name: 'Expenses', description: "Log expenses like rent, supplies or wages and the period's balance subtracts them." },
        { icon: 'userX', name: 'No-shows', description: "If a client didn't come, cancel the past appointment and it stops counting in the cash book. If it was a maintenance visit, the chain ends." },
        { icon: 'receipt', name: 'SIFEN e-invoicing', description: "Invoice appointments and sales from the cash book, with automatic numbering, voiding and reissuing. Requires the business's timbrado and certificate." },
        { icon: 'printer', name: '80 mm receipt', description: 'Issuing an invoice opens the KuDE ready to print on an 80 mm thermal printer.' },
        { icon: 'list', name: 'Invoice requested at booking', description: 'Clients can ask for an invoice and enter their RUC and business name when booking. Those details are filled in when you invoice.' },
      ] },
      { heading: 'Bookings', description: 'Everything so your clients can book easily.', icon: 'calendar', features: [
        { icon: 'calendar', name: 'Online bookings', description: 'Public page where your clients book their appointment without calling.' },
        { icon: 'list', name: 'Multiple services', description: 'Services with duration and price range. With 10 or more services, clients browse by category first.' },
        { icon: 'link', name: 'Multi-services', description: 'Your clients can book multiple services in a single appointment. The system calculates total duration and combined price automatically.' },
        { icon: 'folder', name: 'Categories and prices', description: 'Organize your services by category and display price ranges so clients have a clear idea before booking.' },
        { icon: 'repeat', name: 'Maintenance visits', description: 'For services that need a touch-up, like extensions, the client gets a link to book the maintenance visit within the window you set.' },
        { icon: 'calendarPlus', name: 'Add to calendar', description: 'From the confirmation, the client adds the appointment to Google Calendar or any calendar with an .ics file.' },
      ] },
      { heading: 'Management', description: 'Total control of your team and schedule.', icon: 'grid', features: [
        { icon: 'grid', name: 'Schedule management', description: 'Calendar view by resource with blocks and cancellations.' },
        { icon: 'users', name: 'Staff and resources', description: 'Support for people and physical resources, with admin/staff roles and granular permissions per module.' },
        { icon: 'settings', name: 'Admin panel', description: 'Full configuration: hours, services, blocks and business settings.' },
        { icon: 'lock', name: 'Blocks with reason', description: 'Block time slots, full days or date ranges indicating the reason. Visible on the schedule for the entire team.' },
        { icon: 'shield', name: 'Granular permissions', description: 'Control who sees and manages each schedule. Independent permissions per staff for schedule, blocks and configuration.' },
      ] },
      { heading: 'Branches', description: 'Multiple locations, one panel.', icon: 'building', features: [
        { icon: 'building', name: 'Multi-branch', description: 'Configure all your physical locations. Each branch with its own name, hours and staff.' },
        { icon: 'clock', name: 'Per-branch hours', description: 'Each branch has its own opening hours, independent from the others.' },
        { icon: 'users', name: 'Assigned staff', description: 'Assign each staff member to a specific branch. The system filters who serves where.' },
        { icon: 'mapPin', name: 'Public selector', description: 'When you have more than one active branch, your clients pick where to book in the first step.' },
      ] },
      { heading: 'Communication', description: 'Keep your clients and team informed.', icon: 'bell', features: [
        { icon: 'bell', name: 'Telegram alerts', description: 'Each staff member gets the bookings for their own schedule on Telegram. Bookings for spaces go to the admins.' },
        { icon: 'mail', name: 'Email confirmation', description: 'Your clients receive an email with their appointment details upon confirming the booking.' },
        { icon: 'clock', name: 'Automatic reminders', description: 'Reminders sent automatically before the appointment to reduce no-shows.' },
        { icon: 'messageCircle', name: 'WhatsApp Business', description: "With your WhatsApp Business account, clients get the confirmation and the reminder on WhatsApp even without an email, plus the maintenance link alongside the email. Requires templates approved by Meta." },
        { icon: 'messageCircle', name: 'WhatsApp button', description: 'On the confirmation screen, the client sends you their appointment details on WhatsApp with one tap.' },
      ] },
      { heading: 'Marketing', description: 'Attract more clients and retain the ones you have.', icon: 'sparkles', features: [
        { icon: 'sparkles', name: 'Events & Promotions', description: 'Create promotions with percentage or fixed discounts, visual notifications with icons and color banners. Only one active event at a time. Your clients see offers directly on the booking page.' },
        { icon: 'star', name: 'Client reviews', description: 'Clients rate their experience with stars and text. The average score and recent reviews are shown on your public page.' },
        { icon: 'eyeOff', name: 'Review moderation', description: "Hide reviews that don't belong from the panel. Hidden reviews aren't shown or counted in the average, and you can show them again." },
      ] },
      { heading: 'Analytics', description: 'Clear data to make better decisions.', icon: 'activity', features: [
        { icon: 'activity', name: 'Metrics dashboard', description: 'KPIs of appointments and estimated revenue, charts by period (7, 30, 90 or 365 days, or the current month), service ranking, peak time slots and frequent clients.' },
        { icon: 'palette', name: 'Customization', description: '21 color themes, light and dark, custom logo and configurable labels. Your appointment system with your visual identity.' },
      ] },
    ] as Category[],
    targetTitle: 'For any business that works with appointments',
    targetLead: 'If your business schedules appointments, Slotr is for you.',
    target: ['Clinics', 'Hair salons', 'Consultancies', 'Sports courts', 'Medical offices'],
    targetAny: 'Any business that schedules appointments',
    pricingTitle: 'Pricing based on your team',
    pricingLead: "You pay for the calendars you use. No fixed costs for features you don't need.",
    pricingNote: 'Base price includes 1 resource/calendar. Each additional resource has an extra cost.',
    pricing: [
      { count: '1', unit: 'resource', example: 'Individual office, single hairdresser', featured: false },
      { count: '2–3', unit: 'resources', example: '3 padel courts, 2 professionals', featured: true },
      { count: '4+', unit: 'resources', example: 'Clinic with multiple specialists', featured: false },
    ],
    pricingCta: 'Request',
    supportTitle: 'Direct support and change requests, always included',
    supportText: "Need a new feature or something to work differently? Ask for it. Depending on how complex it is, I apply it right away or add it to what comes next. What solves a problem for one business almost always helps all of them, so every request counts.",
    closingTitle: 'Want your clients to book on their own?',
    closingLead: "Message me and I'll show you how it works.",
  },
};

const SLOTS = ['08:00', '08:45', '09:30', '10:15', '11:00', '14:00', '14:45', '15:30'];
const PICKED = '10:15';
const langs = ['es', 'en'] as const;
---

<BaseLayout
  title="Slotr — Sistema de turnos online | lucassim"
  description="Slotr: sistema de agendamiento de turnos online para clínicas, peluquerías, consultoras y canchas deportivas en Paraguay."
  favicon="/brand/slotr-favicon.svg"
  lang="es"
  bodyClass="bg-md-background text-md-on-surface font-md antialiased"
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Roboto:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="apple-touch-icon" href="/brand/slotr-apple-touch-icon.png" />
    <meta name="theme-color" content="#6750A4" />
  </Fragment>

  <Navbar showLangToggle={true} theme="slotr" />

  {langs.map(lang => {
    const t = copy[lang];
    return (
      <main data-lang={lang} lang={lang} class={lang === 'es' ? '' : 'hidden'}>
        <!-- HERO: mismo split que la página de reservas (panel de marca + formulario claro), a todo el ancho -->
        <section class="relative overflow-hidden bg-md-primary text-white">
          <div class="absolute -top-24 right-[10%] w-80 h-80 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -bottom-32 -left-16 w-96 h-96 rounded-full bg-md-primary-container/20 blur-3xl" aria-hidden="true"></div>
          <HeroIcons icons={[icons.calendar, icons.clock, icons.bell, icons.star, icons.calendarPlus, icons.sparkles]} />
          <div class="relative max-w-6xl mx-auto px-5 sm:px-6 py-12 sm:py-16 lg:py-24 grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 items-center">

            <div class="relative">
              <img src="/brand/slotr-logo-blanco.svg" alt="Slotr" width="480" height="211" class="h-12 sm:h-14 w-auto mb-8" />
              <h1 class="font-md-display text-[2.125rem] min-[380px]:text-[2.5rem] sm:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-[-0.01em] mb-5 max-w-[14ch]">
                {/* La coma de Plus Jakarta Sans trae mucho aire a la izquierda: a este tamaño parece «online ,». */}
                {t.title.split(',')[0]}<span class="-ml-[0.1em]">,</span>{t.title.split(',').slice(1).join(',')}
              </h1>
              <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-[42ch] mb-8">{t.lead}</p>
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center min-h-12 px-7 rounded-full bg-white text-md-primary font-medium shadow-[0_1px_2px_0_rgb(0_0_0/0.06)] hover:shadow-[0_2px_6px_2px_rgb(0_0_0/0.08)] active:scale-95 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                {t.cta}
              </a>
            </div>

            <div class="relative rounded-3xl bg-md-background text-md-on-surface p-5 sm:p-6 shadow-[0_4px_8px_3px_rgb(0_0_0/0.10)]" role="img" aria-label={t.mock.label}>
              <div aria-hidden="true">
                <div class="flex items-center justify-between gap-3 rounded-2xl bg-md-secondary-container ring-2 ring-md-primary px-4 py-3.5 mb-4">
                  <span class="text-sm font-medium">{t.mock.service}</span>
                  <span class="font-md-mono text-xs text-md-on-surface-variant whitespace-nowrap">{t.mock.meta}</span>
                </div>
                <div class="flex items-center gap-2 rounded-t-xl border-b-2 border-md-outline bg-md-surface-variant px-4 py-3 mb-5 text-sm">
                  <span class="w-4 h-4 text-md-on-surface-variant [&>svg]:w-full [&>svg]:h-full" set:html={icons.calendar}></span>
                  {t.mock.date}
                </div>
                <p class="text-xs font-medium text-md-on-surface-variant mb-2.5">{t.mock.slots}</p>
                <div class="grid grid-cols-4 gap-2 mb-6">
                  {SLOTS.map(time => (
                    <span class={`font-md-mono text-sm text-center py-2 rounded-full border ${time === PICKED
                      ? 'bg-md-primary border-md-primary text-white font-medium'
                      : 'border-md-outline text-md-on-surface'}`}>{time}</span>
                  ))}
                </div>
                <div class="rounded-full bg-md-primary text-white text-center text-sm font-medium py-3">{t.mock.confirm}</div>
              </div>
            </div>
          </div>
        </section>

        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <section class="pt-20 sm:pt-24">
            <h2 class="font-md-display text-2xl sm:text-3xl font-bold tracking-tight mb-2">{t.featuresTitle}</h2>
            <p class="text-md-on-surface-variant mb-8">{t.featuresLead}</p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
              {t.categories.map(cat => (
                <article class={`rounded-[28px] bg-md-surface-container p-6 sm:p-8 ${cat.wide ? 'lg:col-span-2' : ''}`}>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="grid place-items-center w-10 h-10 rounded-full bg-md-primary-container text-md-on-primary-container shrink-0">
                      <span class="w-5 h-5 [&>svg]:w-full [&>svg]:h-full" set:html={icons[cat.icon]}></span>
                    </span>
                    <h3 class="font-md-display text-xl font-semibold">{cat.heading}</h3>
                    {cat.isNew && (
                      <span class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full bg-md-primary text-white">{t.newLabel}</span>
                    )}
                  </div>
                  <p class="text-sm text-md-on-surface-variant">{cat.description}</p>
                  <ul class={`mt-4 ${cat.wide ? 'lg:grid lg:grid-cols-2 lg:gap-x-10' : ''}`}>
                    {cat.features.map(f => (
                      <li class={`flex gap-3 py-4 border-t border-md-outline-variant first:border-t-0 ${cat.wide ? 'lg:[&:nth-child(2)]:border-t-0' : ''}`}>
                        <span class="w-[18px] h-[18px] mt-0.5 text-md-primary shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icons[f.icon]}></span>
                        <div>
                          <p class="font-medium mb-1">{f.name}</p>
                          <p class="text-sm text-md-on-surface-variant leading-relaxed">{f.description}</p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>

          <section class="pt-20 sm:pt-24 text-center">
            <h2 class="font-md-display text-2xl sm:text-3xl font-bold tracking-tight mb-2">{t.targetTitle}</h2>
            <p class="text-md-on-surface-variant mb-6">{t.targetLead}</p>
            <ul class="flex flex-wrap justify-center gap-2">
              {t.target.map(name => (
                <li class="px-4 py-2 rounded-full bg-md-secondary-container text-md-on-secondary-container text-sm font-medium">{name}</li>
              ))}
              <li class="px-4 py-2 rounded-full border border-md-outline text-md-on-surface-variant text-sm font-medium">{t.targetAny}</li>
            </ul>
          </section>

          <section class="pt-20 sm:pt-24">
            <div class="text-center mb-8">
              <h2 class="font-md-display text-2xl sm:text-3xl font-bold tracking-tight mb-2">{t.pricingTitle}</h2>
              <p class="text-md-on-surface-variant mb-1">{t.pricingLead}</p>
              <p class="text-sm text-md-on-surface-variant">{t.pricingNote}</p>
            </div>
            <div class="flex flex-col gap-3 max-w-2xl mx-auto">
              {t.pricing.map(r => (
                <div class={`flex items-center gap-5 rounded-2xl px-5 sm:px-6 py-5 ${r.featured
                  ? 'bg-md-secondary-container ring-2 ring-md-primary'
                  : 'bg-md-surface-container'}`}>
                  <p class="w-14 sm:w-20 shrink-0">
                    <span class="block font-md-mono text-3xl font-medium text-md-primary leading-none">{r.count}</span>
                    <span class="block text-xs text-md-on-surface-variant mt-1.5">{r.unit}</span>
                  </p>
                  <p class="flex-1 min-w-0 text-sm sm:text-base">{r.example}</p>
                  <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center min-h-11 px-5 rounded-full border border-md-outline text-md-primary text-sm font-medium hover:bg-md-primary-container active:scale-95 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-md-primary">
                    {t.pricingCta}
                  </a>
                </div>
              ))}
            </div>
            <div class="flex gap-4 max-w-2xl mx-auto mt-4 rounded-2xl bg-md-primary-container/60 p-5 sm:p-6">
              <span class="grid place-items-center w-10 h-10 rounded-full bg-md-background text-md-primary shrink-0">
                <span class="w-5 h-5 [&>svg]:w-full [&>svg]:h-full" set:html={icons.messageCircle}></span>
              </span>
              <div>
                <h3 class="font-md-display font-semibold mb-1">{t.supportTitle}</h3>
                <p class="text-sm text-md-on-surface-variant leading-relaxed">{t.supportText}</p>
              </div>
            </div>
          </section>

          <section class="pt-20 sm:pt-24 text-center">
            <h2 class="font-md-display text-3xl sm:text-4xl font-bold tracking-tight mb-3">{t.closingTitle}</h2>
            <p class="text-md-on-surface-variant mb-8">{t.closingLead}</p>
            <div class="flex flex-wrap justify-center gap-3">
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center min-h-12 px-7 rounded-full bg-md-primary text-white font-medium hover:shadow-[0_2px_6px_2px_rgb(0_0_0/0.08)] active:scale-95 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-md-primary">
                WhatsApp
              </a>
              <a href={`mailto:${EMAIL}`}
                class="inline-flex items-center min-h-12 px-7 rounded-full border border-md-outline text-md-primary font-medium hover:bg-md-primary-container active:scale-95 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-md-primary">
                Email
              </a>
            </div>
          </section>
        </div>
      </main>
    );
  })}

  <script>
    const btns = document.querySelectorAll<HTMLElement>('[data-lang-btn]');
    const sections = document.querySelectorAll<HTMLElement>('[data-lang]');
    btns.forEach(btn => btn.addEventListener('click', () => {
      const lang = btn.dataset.target;
      if (!lang) return;
      sections.forEach(el => el.classList.toggle('hidden', el.dataset.lang !== lang));
      btns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.target === lang)));
      document.documentElement.lang = lang;
    }));
  </script>

  <Footer theme="slotr" />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactButtons from '../components/ContactButtons.astro';
import ProductCard from '../components/ProductCard.astro';
import IndexBackground from '../components/IndexBackground.astro';

const WHATSAPP = 'https://wa.me/595993294266';
const EMAIL    = 'lucas_paniagua@hotmail.com';

const vareappFeatures = [
  'Catálogo digital con variantes y fotos',
  'Pedidos delivery, pickup y mostrador',
  'Caja / POS con factura DNIT',
  'Inventario, clientes y fidelidad',
];

const slotrFeatures = [
  'Reservas online para tus clientes',
  'Calendarios por recurso o profesional',
  'Múltiples servicios configurables',
  'Panel de administración de agenda',
];
---

<BaseLayout title="lucassim — Software SaaS paraguayo">
  <Navbar />

  <div class="relative">
    <IndexBackground />

    <!-- HERO -->
    <section class="relative max-w-5xl lg:max-w-6xl mx-auto px-6 py-24">
      <div class="grid lg:grid-cols-2 lg:gap-12 lg:items-center">
      <div class="text-center lg:text-left">
        <p class="text-xs text-muted uppercase tracking-widest mb-6">lucassim</p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight mb-6">
          Hola, soy Lucas.<br />
          <span class="text-muted">Ingeniero de Sistemas.</span>
        </h1>

        <p class="text-sm text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 mb-4">
          Más de <strong class="text-white font-semibold">5 años de experiencia</strong> desarrollando software.
          Proactivo, orientado al crecimiento y apasionado por construir productos que resuelvan problemas reales.
        </p>

        <p class="text-sm text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 mb-10">
          Desarrollo soluciones diseñadas para el mercado paraguayo — simples, funcionales y listas para escalar.
        </p>

        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a href="#productos" class="px-6 py-2.5 lg:px-7 lg:py-3 rounded-lg text-sm font-bold bg-white text-black hover:bg-gray-100 transition-colors">
            Ver proyectos ↓
          </a>
          <a href="#contacto" class="px-6 py-2.5 lg:px-7 lg:py-3 rounded-lg text-sm font-semibold border border-white/20 text-white hover:border-white/40 hover:bg-white/5 transition-colors">
            Contacto
          </a>
          <a href="/portfolio" class="px-6 py-2.5 lg:px-7 lg:py-3 rounded-lg text-sm font-semibold border border-white/20 text-white hover:border-white/40 hover:bg-white/5 transition-colors">
            Portfolio ↗
          </a>
        </div>
      </div>

      <!-- Visual cluster: subtle 2-product gradient + monogram watermark -->
      <div class="hidden lg:block relative aspect-square max-w-md mx-auto" aria-hidden="true">
        <div class="absolute top-8 right-8 w-48 h-48 rounded-full bg-vareapp/15 blur-3xl"></div>
        <div class="absolute bottom-8 left-8 w-48 h-48 rounded-full bg-slotr/20 blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 rounded-full bg-brand/10 blur-2xl"></div>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <span class="text-[10rem] font-black text-white/[0.04] tracking-tighter select-none leading-none">LS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTOS -->
  <section id="productos" class="max-w-5xl lg:max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-xs text-subtle uppercase tracking-widest mb-8 text-center">Proyectos</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      <ProductCard
        name="VareApp"
        eyebrow="SaaS · Multi-negocio"
        tagline="Catálogo, pedidos y caja para restaurantes y comercios minoristas."
        accent="vareapp"
        features={vareappFeatures}
        businessTypes={['Restaurante', 'Retail']}
        href="/vareapp"
      />
      <ProductCard
        name="Slotr"
        eyebrow="SaaS · Agendamiento"
        tagline="Sistema de turnos online para clínicas, peluquerías, consultoras y canchas deportivas."
        accent="slotr"
        features={slotrFeatures}
        href="/slotr"
      />
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="max-w-3xl lg:max-w-5xl mx-auto px-6 py-16 text-center">
    <div class="lg:grid lg:grid-cols-[1fr_auto] lg:gap-12 lg:items-center lg:text-left">
      <div>
        <h2 class="text-2xl lg:text-3xl font-black mb-3">¿Hablamos?</h2>
        <p class="text-sm text-muted mb-8 lg:mb-0 max-w-md mx-auto lg:mx-0">
          Si te interesa alguno de los productos o tenés una consulta, escribime directamente.
        </p>
      </div>
      <div class="flex justify-center lg:justify-end">
        <ContactButtons whatsapp={WHATSAPP} email={EMAIL} />
      </div>
    </div>
  </section>
  </div>

  <Footer />
</BaseLayout>

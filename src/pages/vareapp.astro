---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactButtons from '../components/ContactButtons.astro';
import { vareappIcons, type VareappIconName } from '../components/vareapp-icons';

const WHATSAPP = 'https://wa.me/595993294266';
const EMAIL    = 'lucas_paniagua@hotmail.com';

interface VareappFeature {
  icon: VareappIconName;
  name: string;
  description: string;
}

interface VareappFeatureCategory {
  heading: string;
  description: string;
  icon: VareappIconName;
  span: number;
  isHighlighted?: boolean;
  features: VareappFeature[];
}

const spanClasses: Record<number, string> = {
  1: 'lg:col-span-1', 2: 'lg:col-span-2', 3: 'lg:col-span-3', 4: 'lg:col-span-4',
  5: 'lg:col-span-5', 6: 'lg:col-span-6', 7: 'lg:col-span-7', 8: 'lg:col-span-8',
  9: 'lg:col-span-9', 10: 'lg:col-span-10', 11: 'lg:col-span-11', 12: 'lg:col-span-12',
};

const featureCategories: VareappFeatureCategory[] = [
  {
    heading: 'Core Compartido',
    description: 'Funcionalidades base para cualquier negocio.',
    icon: 'bookOpen',
    span: 4,
    features: [
      { icon: 'bookOpen', name: 'Catálogo digital', description: 'Productos con categorías, variantes, fotos y stock configurable. Logo personalizado en tu página pública.' },
      { icon: 'clipboardList', name: 'Gestión de pedidos', description: 'Delivery, pickup y mostrador con notificación directa al negocio por WhatsApp.' },
      { icon: 'creditCard', name: 'Caja / POS', description: 'Registro de ventas, venta directa, tickets y facturas electrónicas habilitadas por la DNIT.' },
      { icon: 'settings', name: 'Panel admin', description: 'Control total: productos, horarios, staff, permisos y configuración del negocio.' },
    ],
  },
  {
    heading: 'Restaurante',
    description: 'Todo lo que necesita un negocio gastronómico.',
    icon: 'utensilsCrossed',
    span: 4,
    features: [
      { icon: 'userCheck', name: 'Modo mozo', description: 'Panel simplificado para que los mozos tomen pedidos por mesa desde su celular.' },
      { icon: 'printer', name: 'Comandas cocina', description: 'Tickets 80mm con items, variantes, extras y aclaraciones. Impresión automática.' },
      { icon: 'bot', name: 'Impresión automática', description: 'Agente que imprime pedidos nuevos a impresora térmica ESC/POS sin intervención manual.' },
      { icon: 'creditCard', name: 'Gestión de mesas', description: 'QR por mesa, pedidos directos de clientes y control de ocupación en tiempo real.' },
    ],
  },
  {
    heading: 'Retail',
    description: 'Todo lo que necesita un comercio minorista.',
    icon: 'store',
    span: 4,
    features: [
      { icon: 'package2', name: 'Inventario avanzado', description: 'Control de stock con alertas de bajo inventario, lotes, vencimientos y movimientos.' },
      { icon: 'barcode', name: 'Variantes y SKU', description: 'Tallas, colores, códigos de barra y atributos por producto. Gestión por lote.' },
      { icon: 'users2', name: 'Clientes y fidelidad', description: 'Perfil de cliente, historial de compras, puntos de fidelidad y cupones.' },
      { icon: 'receipt', name: 'Caja retail', description: 'Venta rápida, devoluciones, arqueo de caja y cierre de lote. Múltiples formas de pago.' },
    ],
  },
  {
    heading: 'Marketing',
    description: 'Atraé más clientes y fidelizalos.',
    icon: 'image',
    span: 12,
    isHighlighted: true,
    features: [
      { icon: 'image', name: 'Generador de flyers', description: 'Seleccioná productos, armá tu flyer y exportalo en PDF listo para imprimir o compartir.' },
      { icon: 'tag', name: 'Promociones', description: 'Creá descuentos porcentuales o fijos con banners visuales. Solo una promoción activa a la vez.' },
      { icon: 'star', name: 'Reseñas de clientes', description: 'Los clientes califican su experiencia con estrellas y texto. El puntaje se muestra en tu página pública.' },
    ],
  },
];

const restaurantTarget = ['Restaurantes', 'Cafeterías', 'Food trucks', 'Bares', 'Rotiserías', 'Panaderías'];
const retailTarget     = ['Tiendas de ropa', 'Electrónica', 'Ferreterías', 'Farmacias', 'Regalerías', 'Librerías'];

const esencialIncluded = ['Catálogo digital', 'Gestión de pedidos', 'Panel admin', 'Caja / POS', 'Impresión de ticket'];
const esencialExcluded = ['Factura electrónica (DNIT)', 'Inventario avanzado', 'Métricas avanzadas', 'Modo mozo', 'Comandas cocina'];
const proIncluded      = ['Todo el plan Esencial', 'Factura electrónica (DNIT)', 'Inventario avanzado', 'Métricas avanzadas', 'Modo mozo', 'Comandas cocina', 'Impresión automática'];

const featureCategoriesEn: VareappFeatureCategory[] = [
  {
    heading: 'Shared Core',
    description: 'Base features for any business.',
    icon: 'bookOpen',
    span: 4,
    features: [
      { icon: 'bookOpen', name: 'Digital catalog', description: 'Products with categories, variants, photos and configurable stock. Custom logo on your public page.' },
      { icon: 'clipboardList', name: 'Order management', description: 'Delivery, pickup and counter with direct WhatsApp notification to the business.' },
      { icon: 'creditCard', name: 'POS / Cash register', description: 'Sales log, direct sales, tickets and electronic invoices enabled by DNIT.' },
      { icon: 'settings', name: 'Admin panel', description: 'Total control: products, hours, staff, permissions and business configuration.' },
    ],
  },
  {
    heading: 'Restaurant',
    description: 'Everything a food business needs.',
    icon: 'utensilsCrossed',
    span: 4,
    features: [
      { icon: 'userCheck', name: 'Waiter mode', description: 'Simplified panel for waiters to take orders by table directly from their phone.' },
      { icon: 'printer', name: 'Kitchen tickets', description: '80mm tickets with items, variants, extras and notes. Automatic printing.' },
      { icon: 'bot', name: 'Automatic printing', description: 'Agent that prints new orders to ESC/POS thermal printer. No manual intervention.' },
      { icon: 'creditCard', name: 'Table management', description: 'QR per table, direct customer ordering and real-time occupancy control.' },
    ],
  },
  {
    heading: 'Retail',
    description: 'Everything a retail business needs.',
    icon: 'store',
    span: 4,
    features: [
      { icon: 'package2', name: 'Advanced inventory', description: 'Stock control with low inventory alerts, batches, expirations and movements.' },
      { icon: 'barcode', name: 'Variants and SKU', description: 'Sizes, colors, barcodes and product attributes. Batch management.' },
      { icon: 'users2', name: 'Customers & loyalty', description: 'Customer profile, purchase history, loyalty points and coupons.' },
      { icon: 'receipt', name: 'Retail POS', description: 'Quick sale, returns, cash audit and batch closing. Multiple payment methods.' },
    ],
  },
  {
    heading: 'Marketing',
    description: 'Attract more clients and retain them.',
    icon: 'image',
    span: 12,
    isHighlighted: true,
    features: [
      { icon: 'image', name: 'Flyer generator', description: 'Select products, build your flyer and export it as a PDF ready to print or share.' },
      { icon: 'tag', name: 'Promotions', description: 'Create percentage or fixed discounts with visual banners. Only one active promotion at a time.' },
      { icon: 'star', name: 'Client reviews', description: 'Clients rate their experience with stars and text. The score is shown on your public page.' },
    ],
  },
];

const restaurantTargetEn = ['Restaurants', 'Cafés', 'Food trucks', 'Bars', 'Rotisseries', 'Bakeries'];
const retailTargetEn     = ['Clothing stores', 'Electronics', 'Hardware stores', 'Pharmacies', 'Gift shops', 'Bookstores'];

const esencialIncludedEn = ['Digital catalog', 'Order management', 'Admin panel', 'POS / Cash register', 'Ticket printing'];
const esencialExcludedEn = ['Electronic invoice (DNIT)', 'Advanced inventory', 'Advanced metrics', 'Waiter mode', 'Kitchen tickets'];
const proIncludedEn      = ['Everything in Essential plan', 'Electronic invoice (DNIT)', 'Advanced inventory', 'Advanced metrics', 'Waiter mode', 'Kitchen tickets', 'Automatic printing'];
---

<BaseLayout
  title="VareApp — Catálogo, pedidos y caja | lucassim"
  description="VareApp: sistema de catálogo digital, pedidos y caja para restaurantes y comercios minoristas en Paraguay."
  favicon="/vareapp-icono.png"
>
  <Navbar showLangToggle={true} />

  <!-- ESPAÑOL -->
  <div data-lang="es">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-[#0a0a0f] py-24 text-center px-6">
      <div class="hero-shape absolute top-[15%] left-[12%] w-[180px] h-[180px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.25), transparent 70%); filter: blur(40px);"></div>
      <div class="hero-shape-reverse absolute top-[55%] right-[10%] w-[220px] h-[220px] rounded-full" style="background: radial-gradient(circle, rgba(234,88,12,0.2), transparent 70%); filter: blur(50px);"></div>
      <div class="hero-shape absolute bottom-[10%] left-[35%] w-[140px] h-[140px] rounded-full" style="background: radial-gradient(circle, rgba(251,146,60,0.15), transparent 70%); filter: blur(35px);"></div>
      <div class="hero-shape-reverse absolute top-[25%] right-[28%] w-[100px] h-[100px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.18), transparent 70%); filter: blur(30px);"></div>

      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(249,115,22,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(249,115,22,0.04) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);"></div>

      <div class="hero-icon-float absolute top-[15%] right-[15%]" style="opacity: 0.15;" aria-hidden="true">
        <span set:html={vareappIcons.chefHat} style="width:32px;height:32px;display:block;color:#fb923c;"></span>
      </div>
      <div class="hero-icon-float-reverse absolute bottom-[20%] left-[12%]" style="opacity: 0.12;" aria-hidden="true">
        <span set:html={vareappIcons.store} style="width:28px;height:28px;display:block;color:#f97316;"></span>
      </div>
      <div class="hero-icon-float absolute top-[30%] left-[6%]" style="opacity: 0.10;" aria-hidden="true">
        <span set:html={vareappIcons.shoppingBag} style="width:24px;height:24px;display:block;color:#ea580c;"></span>
      </div>
      <div class="hero-icon-float-reverse absolute bottom-[12%] right-[20%]" style="opacity: 0.12;" aria-hidden="true">
        <span set:html={vareappIcons.pizza} style="width:26px;height:26px;display:block;color:#fb923c;"></span>
      </div>
      <div class="hero-icon-float absolute top-[50%] left-[22%]" style="opacity: 0.10;" aria-hidden="true">
        <span set:html={vareappIcons.receipt} style="width:22px;height:22px;display:block;color:#f97316;"></span>
      </div>

      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-widest text-vareapp mb-4 inline-block px-4 py-1.5 border border-orange-500/30 rounded-full">SaaS · Multi-negocio</p>

        <img src="/vareapp-claro-transparente.png" alt="VareApp" class="h-20 mx-auto mb-4" />

        <h1 class="text-4xl font-black mb-3 vareapp-gradient-text leading-tight">Catálogo, pedidos y caja para tu negocio</h1>

        <p class="text-sm text-muted max-w-md mx-auto mb-8 leading-relaxed">
          Sistema de catálogo digital, pedidos y gestión para restaurantes y comercios minoristas en Paraguay.
        </p>

        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 rounded-lg text-sm font-bold text-white vareapp-cta"
        >
          Consultá por una demo
        </a>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-6">

      <section class="py-16">
        <h2 class="text-xl font-black mb-2">¿Qué incluye VareApp?</h2>
        <p class="text-sm text-muted mb-8">Funcionalidades compartidas y específicas para cada tipo de negocio.</p>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          {featureCategories.map(cat => (
            <div class={`vareapp-card rounded-2xl p-6 ${cat.isHighlighted
              ? 'bg-gradient-to-br from-orange-500/10 to-amber-500/5 border border-orange-500/25'
              : 'bg-white/[0.03] border border-white/[0.06]'
            } ${spanClasses[cat.span] || 'lg:col-span-1'}`}>
              <div class="mb-4">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                  <span class="text-vareapp" set:html={vareappIcons[cat.icon]} style="width:20px;height:20px;display:inline-block;"></span>
                  {cat.heading}
                </h3>
                <p class="text-xs text-subtle mt-1">{cat.description}</p>
              </div>

              <div class={`grid gap-2.5 ${cat.features.length >= 4 ? 'grid-cols-1 md:grid-cols-2' : cat.features.length >= 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1'}`}>
                {cat.features.map(f => (
                  <div class="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                    <span class="text-vareapp mb-1.5 block" set:html={vareappIcons[f.icon]} style="width:16px;height:16px;display:block;"></span>
                    <p class="text-[0.7rem] font-bold text-white mb-0.5">{f.name}</p>
                    <p class="text-[0.6rem] text-subtle leading-relaxed">{f.description}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="py-12 border-t border-border">
        <h2 class="text-xl font-black mb-2">Para dos tipos de negocio</h2>
        <p class="text-sm text-muted mb-6">VareApp se adapta a restaurantes y comercios minoristas por igual.</p>
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-vareapp mb-3 flex items-center gap-2">
              <span set:html={vareappIcons.utensilsCrossed} style="width:14px;height:14px;display:inline-block;"></span>
              Restaurante
            </h3>
            <div class="flex flex-wrap gap-2">
              {restaurantTarget.map(t => (
                <span class="px-4 py-1.5 rounded-full text-xs font-semibold border border-orange-900 text-vareapp bg-vareapp-dark">
                  {t}
                </span>
              ))}
            </div>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-vareapp mb-3 flex items-center gap-2">
              <span set:html={vareappIcons.store} style="width:14px;height:14px;display:inline-block;"></span>
              Retail
            </h3>
            <div class="flex flex-wrap gap-2">
              {retailTarget.map(t => (
                <span class="px-4 py-1.5 rounded-full text-xs font-semibold border border-orange-900 text-vareapp bg-vareapp-dark">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="px-4 py-1.5 rounded-full text-xs font-semibold border border-border text-muted">
            Cualquier negocio con catálogo, pedidos y caja
          </span>
        </div>
      </section>

      <section class="py-12 border-t border-white/[0.06]">
        <h2 class="text-xl font-black mb-2">Elegí el plan que se ajusta a tu negocio</h2>
        <p class="text-sm text-muted mb-8">Precios a consultar — sin sorpresas.</p>
        <div class="grid sm:grid-cols-2 gap-6">

          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 flex flex-col">
            <p class="text-xs font-bold uppercase tracking-widest text-muted mb-2">Plan</p>
            <h3 class="text-2xl font-black mb-1">Esencial</h3>
            <p class="text-xs text-subtle italic mb-6">Consultá por el precio</p>
            <ul class="flex flex-col gap-2 flex-1 mb-3">
              {esencialIncluded.map(f => (
                <li class="text-xs text-muted flex items-center gap-2">
                  <span class="text-vareapp">✓</span> {f}
                </li>
              ))}
              {esencialExcluded.map(f => (
                <li class="text-xs text-subtle flex items-center gap-2 opacity-40">
                  <span>✕</span> <span class="line-through">{f}</span>
                </li>
              ))}
            </ul>
            <p class="text-xs text-subtle italic mb-4">*El ticket no tiene valor fiscal.</p>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
              class="block text-center py-2 rounded-lg text-xs font-bold border border-border text-muted hover:border-muted hover:text-white transition-colors">
              Consultar
            </a>
          </div>

          <div class="bg-vareapp-dark/50 border border-orange-500/25 rounded-2xl p-6 flex flex-col">
            <p class="text-xs font-bold uppercase tracking-widest text-vareapp mb-2">⭐ Más completo</p>
            <h3 class="text-2xl font-black mb-1">Pro</h3>
            <p class="text-xs text-subtle italic mb-6">Consultá por el precio</p>
            <ul class="flex flex-col gap-2 flex-1 mb-3">
              {proIncluded.map((f, i) => (
                <li class={`text-xs flex items-center gap-2 ${i === 1 ? 'text-vareapp font-semibold' : 'text-muted'}`}>
                  <span class="text-vareapp">{i === 1 ? '★' : '✓'}</span> {f}
                </li>
              ))}
            </ul>
            <p class="text-xs text-subtle italic mb-4">La factura electrónica tiene plena validez fiscal habilitada por la DNIT.</p>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
              class="block text-center py-2 rounded-lg text-xs font-bold border border-vareapp text-vareapp hover:bg-vareapp hover:text-white transition-colors">
              Consultar
            </a>
          </div>

        </div>
      </section>

      <section class="py-16 text-center border-t border-white/[0.06]">
        <h2 class="text-2xl font-black mb-3">¿Listo para digitalizar tu negocio?</h2>
        <p class="text-sm text-muted mb-8">Escribime y coordinamos una demo personalizada.</p>
        <ContactButtons whatsapp={WHATSAPP} email={EMAIL} />
      </section>

    </div>
  </div>

  <!-- ENGLISH -->
  <div data-lang="en" class="hidden">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-[#0a0a0f] py-24 text-center px-6">
      <div class="hero-shape absolute top-[15%] left-[12%] w-[180px] h-[180px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.25), transparent 70%); filter: blur(40px);"></div>
      <div class="hero-shape-reverse absolute top-[55%] right-[10%] w-[220px] h-[220px] rounded-full" style="background: radial-gradient(circle, rgba(234,88,12,0.2), transparent 70%); filter: blur(50px);"></div>
      <div class="hero-shape absolute bottom-[10%] left-[35%] w-[140px] h-[140px] rounded-full" style="background: radial-gradient(circle, rgba(251,146,60,0.15), transparent 70%); filter: blur(35px);"></div>
      <div class="hero-shape-reverse absolute top-[25%] right-[28%] w-[100px] h-[100px] rounded-full" style="background: radial-gradient(circle, rgba(249,115,22,0.18), transparent 70%); filter: blur(30px);"></div>

      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(249,115,22,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(249,115,22,0.04) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);"></div>

      <div class="hero-icon-float absolute top-[15%] right-[15%]" style="opacity: 0.15;" aria-hidden="true">
        <span set:html={vareappIcons.chefHat} style="width:32px;height:32px;display:block;color:#fb923c;"></span>
      </div>
      <div class="hero-icon-float-reverse absolute bottom-[20%] left-[12%]" style="opacity: 0.12;" aria-hidden="true">
        <span set:html={vareappIcons.store} style="width:28px;height:28px;display:block;color:#f97316;"></span>
      </div>
      <div class="hero-icon-float absolute top-[30%] left-[6%]" style="opacity: 0.10;" aria-hidden="true">
        <span set:html={vareappIcons.shoppingBag} style="width:24px;height:24px;display:block;color:#ea580c;"></span>
      </div>
      <div class="hero-icon-float-reverse absolute bottom-[12%] right-[20%]" style="opacity: 0.12;" aria-hidden="true">
        <span set:html={vareappIcons.pizza} style="width:26px;height:26px;display:block;color:#fb923c;"></span>
      </div>
      <div class="hero-icon-float absolute top-[50%] left-[22%]" style="opacity: 0.10;" aria-hidden="true">
        <span set:html={vareappIcons.receipt} style="width:22px;height:22px;display:block;color:#f97316;"></span>
      </div>

      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-widest text-vareapp mb-4 inline-block px-4 py-1.5 border border-orange-500/30 rounded-full">SaaS · Multi-business</p>

        <img src="/vareapp-claro-transparente.png" alt="VareApp" class="h-20 mx-auto mb-4" />

        <h1 class="text-4xl font-black mb-3 vareapp-gradient-text leading-tight">Catalog, orders &amp; POS for your business</h1>

        <p class="text-sm text-muted max-w-md mx-auto mb-8 leading-relaxed">
          Digital catalog, order and management system for restaurants and retail businesses in Paraguay.
        </p>

        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 rounded-lg text-sm font-bold text-white vareapp-cta"
        >
          Request a demo
        </a>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-6">

      <section class="py-16">
        <h2 class="text-xl font-black mb-2">What's included in VareApp?</h2>
        <p class="text-sm text-muted mb-8">Shared and specific features for each business type.</p>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          {featureCategoriesEn.map(cat => (
            <div class={`vareapp-card rounded-2xl p-6 ${cat.isHighlighted
              ? 'bg-gradient-to-br from-orange-500/10 to-amber-500/5 border border-orange-500/25'
              : 'bg-white/[0.03] border border-white/[0.06]'
            } ${spanClasses[cat.span] || 'lg:col-span-1'}`}>
              <div class="mb-4">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                  <span class="text-vareapp" set:html={vareappIcons[cat.icon]} style="width:20px;height:20px;display:inline-block;"></span>
                  {cat.heading}
                </h3>
                <p class="text-xs text-subtle mt-1">{cat.description}</p>
              </div>

              <div class={`grid gap-2.5 ${cat.features.length >= 4 ? 'grid-cols-1 md:grid-cols-2' : cat.features.length >= 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1'}`}>
                {cat.features.map(f => (
                  <div class="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                    <span class="text-vareapp mb-1.5 block" set:html={vareappIcons[f.icon]} style="width:16px;height:16px;display:block;"></span>
                    <p class="text-[0.7rem] font-bold text-white mb-0.5">{f.name}</p>
                    <p class="text-[0.6rem] text-subtle leading-relaxed">{f.description}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="py-12 border-t border-border">
        <h2 class="text-xl font-black mb-2">For two types of business</h2>
        <p class="text-sm text-muted mb-6">VareApp adapts to restaurants and retail businesses alike.</p>
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-vareapp mb-3 flex items-center gap-2">
